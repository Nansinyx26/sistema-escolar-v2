# ============================================
# CONFIGURAÇÃO DO BACKEND — Sistema Escolar
# ============================================
# 1. Copie este arquivo para: backend/.env
# 2. Preencha os valores reais
# 3. NUNCA commite o .env real no git (já está no .gitignore)
#
# NOTA DE SEGURANÇA: todos os valores abaixo ficam propositalmente VAZIOS.
# Placeholders com formato de credencial real (prefixos re_, sk_, AIza,
# usuario:senha@host) disparam scanners de vazamento como o GitGuardian.

# ============================================
# BANCO DE DADOS (MongoDB Atlas) — OBRIGATÓRIO
# ============================================
# Obtenha em: MongoDB Atlas → Connect → Drivers → Copy connection string
#
# ⚠️ Use o banco de DESENVOLVIMENTO aqui (Issue #60). Produção vive em
# `.env.producao` e só é alcançada por `npm run db:producao`, que exige
# confirmação explícita. O banco abaixo é criado sozinho na primeira escrita —
# não precisa criar nada no Atlas. Popule com `npm run seed:dev`.
MONGODB_URI=
MONGODB_DB_NAME=escola_dev

# ============================================
# SERVIDOR
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# SEGURANÇA — OBRIGATÓRIAS EM PRODUÇÃO
# ============================================
# Gere cada uma com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# ============================================
# CONTA ADMINISTRADORA (scripts/criar-admin.js) — opcional
# ============================================
# Usadas SOMENTE pelo script de provisionamento, nunca pelo servidor.
# ADMIN_SENHA é opcional: se ficar vazia, o script gera uma senha aleatória e
# a exibe uma única vez. O banco guarda apenas o hash bcrypt.
#   node scripts/criar-admin.js            # cria
#   node scripts/criar-admin.js --reset    # redefine a senha de conta existente
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=
ADMIN_TELEFONE=

# ADMIN_PATH — apelido secreto da área administrativa.
# Com ADMIN_PATH=f3a91c7d5e4b, as telas de administração passam a responder em
# /html/f3a91c7d5e4b/... e o previsível /html/admin/... devolve 404 para TODO
# MUNDO, inclusive admin. Vazia = comportamento padrão (/html/admin).
# Gere com: node -e "console.log(require('crypto').randomBytes(9).toString('hex'))"
#
# Isto é OFUSCAÇÃO, não autorização: quem descobrir o caminho continua barrado
# pelo gate de perfil (src/middleware/protegerPaginas.js), que é a defesa real.
# O ganho é sair do espaço de URLs que scanner automático testa primeiro e não
# deixar a resposta confirmar que a área existe. Fica no ambiente, e não no
# código, porque no fonte seria só mais uma string legível para quem tem o repo.
ADMIN_PATH=

# ============================================
# URL DO FRONTEND (CORS e links de e-mail)
# ============================================
# Em produção, defina a URL completa onde o frontend está hospedado
FRONTEND_URL=http://localhost:3001

# ============================================
# GOOGLE OAUTH (login com Google no portal) — opcional
# ============================================
# Client ID criado em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# ============================================
# E-MAIL / SMTP (recuperação de senha, notificações) — opcional
# ============================================
# Provedor padrão: Resend (smtp.resend.com). Para Gmail, use smtp.gmail.com
# com senha de app (não a senha da conta).
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# ============================================
# TTS / IA — PROVEDORES DE VOZ E TEXTO — opcionais
# ============================================
# Gemini: https://aistudio.google.com/app/apikey
GOOGLE_TTS_API_KEY=
# ElevenLabs: https://elevenlabs.io → Profile Settings → API Key
ELEVENLABS_API_KEY=

# Copiloto de IA (página ia-assistant). Sem chave o assistente responde 503.
# Numa chave de nível gratuito a cota DIÁRIA se esgota e o assistente passa a
# responder "atingiu o limite de uso" até o dia seguinte — nesse caso a saída é
# ativar faturamento no projeto da chave.
# Aceita também GEMINI_API_KEY / GOOGLE_API_KEY (mesma cascata do TTS).
GEMINI_KEY=
# Opcional: modelo tentado primeiro. Vazio usa o padrão do código, que já cai
# em modelos alternativos quando um deles recusa por cota.
IA_MODELO=

# ============================================
# OBSERVABILIDADE / LOGS
# ============================================
# Se definido, GET /api/metrics em produção exige Authorization: Bearer <token>
METRICS_TOKEN=

# Os logs saem em JSON estruturado (uma linha por evento) em stdout, prontos
# para o agregador da plataforma. Todo log passa por Data Masking: senhas,
# tokens, CPF e nomes de aluno nunca são gravados. Ver src/utils/logSanitizer.js.
#
# LOG_LEVEL: menor nível emitido — debug | info | warn | error | fatal
# Padrão: 'info' em produção, 'debug' fora dela.
LOG_LEVEL=

# CONSOLE_GUARD: 'false' desliga o redirecionamento do `console.*` legado para
# o logger estruturado. Só desligue para depurar o próprio logger — com ele
# desligado, os console.* remanescentes voltam a escapar da sanitização.
CONSOLE_GUARD=

# ============================================
# CORS — ORIGENS PERMITIDAS
# ============================================
# A allowlist embutida (localhost + domínio de produção) vale em TODO ambiente.
# Use esta variável para liberar um domínio extra (ex.: staging) sem reabrir a
# reflexão geral de Origin. Separe múltiplas origens por vírgula.
# Formato: esquema + host + porta, sem barra final.
CORS_EXTRA_ORIGINS=

# ============================================
# RATE LIMITING — tetos por janela (opcionais)
# ============================================
# Ausente ou inválido = usa o padrão seguro indicado ao lado.
# Cada endpoint sensível é limitado por IP **e** por conta-alvo; afrouxar o
# teto por CONTA é o que reabre brute force distribuído, então mexa por último.
RATE_LIMIT_LOGIN_IP=            # padrão 15  / 15 min por IP
RATE_LIMIT_LOGIN_CONTA=         # padrão 10  / 15 min por conta
RATE_LIMIT_CODIGO_IP=           # padrão 30  / 1 h  por IP
RATE_LIMIT_CODIGO_CONTA=        # padrão 10  / 1 h  por conta

# ============================================
# NÃO DEFINA EM PRODUÇÃO
# ============================================
# CSRF_DISABLE_FOR_TESTS: dispensa o token CSRF. É definido automaticamente
# pelo globalSetup do Jest e só tem efeito junto com NODE_ENV=test. Existe
# justamente para que a proteção NÃO dependa apenas de NODE_ENV — um ambiente
# que herde NODE_ENV=test por engano continua protegido. Nunca defina à mão.
