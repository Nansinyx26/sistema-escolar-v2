# ============================================
# CONFIGURAÇÃO DO BACKEND — Sistema Escolar
# ============================================
# 1. Copie este arquivo para: backend/.env
# 2. Preencha os valores reais
# 3. NUNCA commite o .env real no git (já está no .gitignore)
#
# NOTA DE SEGURANÇA: todos os valores abaixo ficam propositalmente VAZIOS.
# Placeholders com formato de credencial real (prefixos re_, sk_, AIza,
# usuario:senha@host) disparam scanners de vazamento como o GitGuardian.

# ============================================
# BANCO DE DADOS (MongoDB Atlas) — OBRIGATÓRIO
# ============================================
# Obtenha em: MongoDB Atlas → Connect → Drivers → Copy connection string
MONGODB_URI=
MONGODB_DB_NAME=test

# ============================================
# SERVIDOR
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# SEGURANÇA — OBRIGATÓRIAS EM PRODUÇÃO
# ============================================
# Gere cada uma com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
SESSION_SECRET=

# ============================================
# URL DO FRONTEND (CORS e links de e-mail)
# ============================================
# Em produção, defina a URL completa onde o frontend está hospedado
FRONTEND_URL=http://localhost:3001

# ============================================
# GOOGLE OAUTH (login com Google no portal) — opcional
# ============================================
# Client ID criado em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# ============================================
# E-MAIL / SMTP (recuperação de senha, notificações) — opcional
# ============================================
# Provedor padrão: Resend (smtp.resend.com). Para Gmail, use smtp.gmail.com
# com senha de app (não a senha da conta).
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# ============================================
# TTS / IA — PROVEDORES DE VOZ E TEXTO — opcionais
# ============================================
# Gemini: https://aistudio.google.com/app/apikey
GOOGLE_TTS_API_KEY=
# ElevenLabs: https://elevenlabs.io → Profile Settings → API Key
ELEVENLABS_API_KEY=

# ============================================
# OBSERVABILIDADE — opcional
# ============================================
# Se definido, GET /api/metrics em produção exige Authorization: Bearer <token>
METRICS_TOKEN=

# ============================================
# CORS — ORIGENS PERMITIDAS
# ============================================
# A allowlist embutida (localhost + domínio de produção) vale em TODO ambiente.
# Use esta variável para liberar um domínio extra (ex.: staging) sem reabrir a
# reflexão geral de Origin. Separe múltiplas origens por vírgula.
# Formato: esquema + host + porta, sem barra final.
CORS_EXTRA_ORIGINS=

# ============================================
# RATE LIMITING — tetos por janela (opcionais)
# ============================================
# Ausente ou inválido = usa o padrão seguro indicado ao lado.
# Cada endpoint sensível é limitado por IP **e** por conta-alvo; afrouxar o
# teto por CONTA é o que reabre brute force distribuído, então mexa por último.
RATE_LIMIT_LOGIN_IP=            # padrão 15  / 15 min por IP
RATE_LIMIT_LOGIN_CONTA=         # padrão 10  / 15 min por conta
RATE_LIMIT_CODIGO_IP=           # padrão 30  / 1 h  por IP
RATE_LIMIT_CODIGO_CONTA=        # padrão 10  / 1 h  por conta

# ============================================
# NÃO DEFINA EM PRODUÇÃO
# ============================================
# CSRF_DISABLE_FOR_TESTS: dispensa o token CSRF. É definido automaticamente
# pelo globalSetup do Jest e só tem efeito junto com NODE_ENV=test. Existe
# justamente para que a proteção NÃO dependa apenas de NODE_ENV — um ambiente
# que herde NODE_ENV=test por engano continua protegido. Nunca defina à mão.
