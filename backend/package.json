{
    "name": "sistema-cadastro-escolar-backend",
    "version": "1.0.0",
    "description": "Backend API for School Management System v2",
    "main": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "dev": "nodemon src/index.js",
        "migrate": "node src/database/DatabaseMigrations.js",
        "migrate:status": "node src/database/DatabaseMigrations.js status",
        "migrate:up": "node src/database/DatabaseMigrations.js up",
        "migrate:down": "node src/database/DatabaseMigrations.js down",
        "migrate:create": "node src/database/DatabaseMigrations.js create",
        "db:producao": "node scripts/db-alvo.js producao",
        "importar:indexeddb": "node scripts/importar_indexeddb_historico.js",
        "seed:escolas": "node scripts/seedEscolas.js",
        "seed:dev": "node scripts/seedDesenvolvimento.js",
        "migrate:multiescola": "node scripts/migrarParaMultiEscola.js",
        "migrate:webp": "node scripts/migrate-with-webp.js",
        "migrate:voice": "node scripts/migrate_voice_preferences.js",
        "test:api": "node scripts/test_endpoints.js",
        "test": "jest --forceExit --runInBand",
        "test:pdf": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js src/tests/parserSeducPdf.test.js --forceExit --runInBand",
        "test:watch": "jest --watch --forceExit --runInBand",
        "test:coverage": "jest --coverage --forceExit --runInBand"
    },
    "dependencies": {
        "@socket.io/mongo-adapter": "^0.4.0",
        "bcryptjs": "^2.4.3",
        "compression": "^1.8.1",
        "connect-mongo": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-rate-limit": "^7.4.1",
        "express-session": "^1.19.0",
        "google-auth-library": "^10.6.2",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.0",
        "mongoose": "^8.24.1",
        "multer": "^2.2.0",
        "node-cache": "^5.1.2",
        "node-cron": "^4.2.1",
        "node-fetch": "^2.7.0",
        "nodemailer": "^9.0.3",
        "pdf-parse": "^2.4.5",
        "pdfmake": "0.2.10",
        "pino": "^9.14.0",
        "sanitize-html": "2.17.1",
        "sharp": "^0.35.3",
        "socket.io": "^4.8.3",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@babel/preset-env": "^8.0.2",
        "dompurify": "^3.4.12",
        "jest": "^29",
        "jest-environment-jsdom": "^29.7.0",
        "mongodb-memory-server": "^10",
        "nodemon": "^3.1.7",
        "pino-pretty": "^11.3.0",
        "supertest": "^7"
    },
    "overrides": {
        "body-parser": "^1.20.6"
    },
    "engines": {
        "node": ">=20.9.0"
    },
    "license": "ISC"
}
