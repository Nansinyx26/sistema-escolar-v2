# ============================================
# CONFIGURAÇÃO MONGODB ATLAS
# ============================================
# O arquivo de configuração completo do backend fica em: backend/.env.example
#
# NOTA DE SEGURANÇA: valores propositalmente vazios — exemplos com formato
# de credencial real (usuario:senha@host) disparam scanners de vazamento.

# Connection String do MongoDB Atlas
# Obtenha em: MongoDB Atlas → Connect → Drivers → Copy connection string
MONGODB_URI=

# Nome do banco de dados
MONGODB_DB_NAME=test

# ============================================
# PARA DESENVOLVIMENTO LOCAL (OPCIONAL)
# ============================================
# MONGODB_URI=mongodb://localhost:27017/escola_db

# ============================================
# INSTRUÇÕES
# ============================================
# 1. Copie este arquivo para: .env (na pasta backend/)
# 2. Preencha os valores reais
# 3. Nunca compartilhe o .env preenchido (já está no .gitignore)

# ============================================
# OBSERVABILIDADE  (ver docs/OBSERVABILITY.md)
# ============================================
# TUDO desligado por padrão. Cada provedor só liga com a flag em "true"
# E a credencial correspondente presente. Em NODE_ENV=test nada inicializa.

# --- OpenTelemetry: a base vendor-neutral (traces/metrics) ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=sistema-escolar-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
# Amostragem: 0.0 a 1.0 (padrão 0.1 em produção, 1.0 fora dela)
OTEL_TRACES_SAMPLE_RATE=

# --- Sentry: exceções e release health ---
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_PROFILES_SAMPLE_RATE=0

# --- Datadog: APM (NÃO usar junto com New Relic em produção) ---
DATADOG_ENABLED=false
DD_API_KEY=
DD_SITE=datadoghq.com
DD_AGENT_HOST=localhost
DD_TRACE_AGENT_PORT=8126

# --- New Relic: APM alternativo ---
NEWRELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=sistema-escolar-backend

# Desliga toda a observabilidade de uma vez, ignorando as flags acima
OBSERVABILITY_DISABLED=false

# Identifica a versão nos eventos (o CI já preenche via RENDER_GIT_COMMIT)
RELEASE_VERSION=
