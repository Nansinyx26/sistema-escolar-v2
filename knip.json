{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "index.html",
                "html/**/*.html",
                "js/*.js",
                "scripts/*.js",
                "service-worker.js",
                "sw.js",
                "inject-*.js",
                "tailwind.config.js"
            ],
            "project": ["js/**/*.js", "scripts/**/*.js", "*.js"],
            "ignore": ["js/libs/**", "js/legacy/**", "js/*.min.js", "js/events/**"],
            "ignoreDependencies": [
                "daisyui",
                "autoprefixer",
                "postcss",
                "mongodb-memory-server",
                "jest"
            ]
        },
        "backend": {
            "entry": ["src/index.js", "migrations/*.js", "scripts/*.js", "tests/**/*.test.js"],
            "project": ["src/**/*.js"],
            "ignore": ["src/tests/**"],
            "ignoreDependencies": [
                "pino-pretty",
                "@opentelemetry/*",
                "@sentry/node",
                "dd-trace",
                "newrelic",
                "jest-environment-jsdom"
            ]
        },
        "portal-responsavel": {
            "entry": ["src/main.tsx"],
            "project": ["src/**/*.{ts,tsx}"],
            "ignoreDependencies": [
                "clsx",
                "tailwind-merge",
                "class-variance-authority",
                "radix-ui",
                "tw-animate-css"
            ]
        }
    },
    "ignoreBinaries": ["gh", "biome", "playwright"],
    "ignoreExportsUsedInFile": true,
    "rules": {
        "files": "off",
        "dependencies": "warn",
        "devDependencies": "warn",
        "unlisted": "warn",
        "exports": "warn",
        "types": "warn",
        "duplicates": "warn"
    }
}
