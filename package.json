{
    "name": "sistema-escolar-v2-root",
    "version": "1.0.0",
    "description": "Root package for school management system",
    "scripts": {
        "install-backend": "cd backend && npm install --legacy-peer-deps",
        "build": "npm run install-backend && npm run build:css && npm run build:tailwind",
        "start": "cd backend && npm start",
        "dev": "cd backend && npm run dev",
        "build:css": "sass scss/main.scss css/main-compiled.css --style=compressed",
        "build:tailwind": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind-built.css --minify",
        "watch:css": "sass scss/main.scss css/main-compiled.css --watch --style=expanded",
        "lint": "biome check .",
        "lint:changed": "biome check --changed --error-on-warnings=false",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "arch": "depcruise --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json backend/src js scripts",
        "arch:baseline": "depcruise --config .dependency-cruiser.cjs --output-type baseline backend/src js scripts > .dependency-cruiser-known-violations.json",
        "arch:all": "depcruise --config .dependency-cruiser.cjs backend/src js scripts",
        "arch:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot backend/src | dot -T svg > docs/arquitetura.svg",
        "knip": "knip --no-exit-code",
        "knip:fix": "knip --fix",
        "test": "cd backend && npm test",
        "test:coverage": "cd backend && npm run test:coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:install": "playwright install --with-deps chromium firefox",
        "test:mutation": "stryker run",
        "verify": "npm run lint:changed && npm run arch && npm run knip && npm run test:coverage",
        "verify:full": "npm run lint && npm run arch && npm run knip && npm run test:coverage",
        "motion:inject": "node scripts/inject-motion.js",
        "motion:inject:dry": "node scripts/inject-motion.js --dry-run",
        "issues:bootstrap": "bash scripts/gh-bootstrap.sh",
        "issues:bootstrap:dry": "bash scripts/gh-bootstrap.sh --dry-run",
        "obs:install:otel": "cd backend && npm i @opentelemetry/sdk-node @opentelemetry/auto-instrumentations-node @opentelemetry/exporter-trace-otlp-http @opentelemetry/resources @opentelemetry/semantic-conventions @opentelemetry/api",
        "obs:install:sentry": "cd backend && npm i @sentry/node",
        "obs:install:datadog": "cd backend && npm i dd-trace",
        "obs:install:newrelic": "cd backend && npm i newrelic",
        "prepare": "husky",
        "knip:strict": "knip"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@biomejs/biome": "^2.3.14",
        "@commitlint/cli": "^19.6.1",
        "@commitlint/config-conventional": "^19.6.0",
        "@playwright/test": "^1.50.1",
        "@stryker-mutator/core": "^8.7.1",
        "@stryker-mutator/jest-runner": "^8.7.1",
        "autoprefixer": "^10.5.0",
        "daisyui": "^4.12.14",
        "dependency-cruiser": "^16.9.0",
        "husky": "^9.1.7",
        "knip": "^5.43.6",
        "postcss": "^8.5.23",
        "sass": "^1.99.0",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3"
    }
}
